{
  "name": "@bazokhan/sightglass-nest",
  "version": "0.1.2",
  "description": "Explicit Sightglass observability for NestJS applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazokhan/sightglass.git",
    "directory": "packages/nest"
  },
  "homepage": "https://github.com/bazokhan/sightglass#readme",
  "bugs": {
    "url": "https://github.com/bazokhan/sightglass/issues"
  },
  "keywords": [
    "observability",
    "nestjs",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bazokhan/sightglass-core": "0.1.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "reflect-metadata": ">=0.2",
    "rxjs": ">=7"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
