    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bazokhan/sightglass-core": "0.1.2"
  },
  "peerDependencies": {
    "fastify": ">=5.0"
  },
  "devDependencies": {
    "fastify": "^5.6.0"
  }
}
