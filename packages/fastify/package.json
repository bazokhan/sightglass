{
  "name": "@bazokhan/sightglass-fastify",
  "version": "0.1.2",
  "description": "Explicit Sightglass observability for Fastify applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazokhan/sightglass.git",
    "directory": "packages/fastify"
  },
  "homepage": "https://github.com/bazokhan/sightglass#readme",
  "bugs": {
    "url": "https://github.com/bazokhan/sightglass/issues"
  },
  "keywords": [
    "observability",
    "fastify",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
